# Interruttore generale: finche' e' false funzionano solo doctor, replay e i --dry-run.
SUP_ENABLED=false
# firestore | sqlite | memory
SUP_STORE=sqlite
SUP_SQLITE_PATH=supervisor.sqlite3
# Progetto GCP dedicato allo stato del supervisore.
SUP_FIRESTORE_PROJECT=gtp-supervisor
# Progetto del gioco, solo lettura di `promo_posts` (vuoto = collector Promo non configurato).
SUP_GAME_FIRESTORE_PROJECT=
# Token GitHub in sola lettura. In locale: `gh auth token`. In Actions: token della GitHub App.
SUP_GITHUB_TOKEN=
# Bot approvazioni di Promo Studio, usato SOLO per sendMessage (vedi docs/adr/0002).
SUP_TELEGRAM_BOT_TOKEN=
SUP_ADMIN_CHAT_ID=
# Chiamate AI (M2): servono anche config/budget.toml approved = true e modelli verificati nel catalogo.
SUP_AI_ENABLED=false
# Chiavi dedicate al supervisore (lette da LiteLLM). Mai le stesse di altri progetti.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
